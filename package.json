{
  "name": "nestwright",
  "productName": "Nestwright",
  "version": "0.16.0",
  "private": true,
  "description": "Design your dream home together.",
  "author": "Peixoto Labs",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/mcpeixoto/Nestwright.git"
  },
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:electron",
    "build:electron": "node scripts/build-electron.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "visual": "node scripts/visual/shoot.mjs --serve --out visual-out",
    "content:fetch": "node scripts/content/fetch-pack.mjs",
    "content:build": "node scripts/content/fetch.mjs && node scripts/content/process.mjs && node scripts/content/validate.mjs && node scripts/content/docs.mjs",
    "content:pack": "node scripts/content/pack.mjs",
    "electron:dev": "npm run build:electron && concurrently -k \"vite --strictPort\" \"wait-on tcp:5173 && cross-env NESTWRIGHT_DEV_URL=http://localhost:5173 electron .\"",
    "dist:mac": "npm run build && node scripts/dist.mjs mac",
    "dist:mac:signed": "scripts/packaging/dist-mac-signed.sh",
    "dist:win": "npm run build && node scripts/dist.mjs win",
    "dist:linux": "npm run build && node scripts/dist.mjs linux",
    "size:check": "node scripts/packaging/check-size.mjs"
  },
  "dependencies": {
    "@dgreenheck/ez-tree": "1.1.0",
    "@types/ws": "^8.18.2",
    "earcut": "^3.0.2",
    "immer": "^11.0.0",
    "jspdf": "^3.0.4",
    "pdfjs-dist": "5.4.296",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "steamworks.js": "^0.4.0",
    "three": "^0.187.0",
    "ws": "^8.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.65.0",
    "@types/earcut": "^3.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "jsdom": "^27.0.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0",
    "wait-on": "^9.0.0"
  }
}
